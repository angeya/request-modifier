{
  "manifest_version": 3,
  "name": "请求修改器",
  "version": "0.0.1",
  "description": "请求修改工具，支持Chrome和Edge等主流浏览器。",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "128": "icon_disabled.png"
    }
  },
  "icons": {
    "128": "icon_disabled.png"
  }
}